{
  "name": "flexible-persian-datepicker",
  "version": "1.3.1",
  "description": "Flexible, responsive Jalali (Solar Hijri) datepicker for React with editable inputs, custom formats, disabled ranges and bundled Persian font.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "docs/assets",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.css.js"
  ],
  "keywords": [
    "react",
    "react-datepicker",
    "calendar",
    "jalali",
    "shamsi",
    "solar-hijri",
    "persian",
    "datepicker",
    "persian-datepicker",
    "rtl",
    "typescript"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "react-date-object": "^2.1.9",
    "zaman": "^2.1.1"
  },
  "devDependencies": {
    "copyfiles": "^2.4.1",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shivatalebi/react-jalali-datepicker.git"
  },
  "homepage": "https://github.com/shivatalebi/react-jalali-datepicker#readme",
  "bugs": {
    "url": "https://github.com/shivatalebi/react-jalali-datepicker/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
